"use client"

import { useStore } from "@/lib/store"
import { format, startOfWeek, addDays } from "date-fns"

export function DebugDates() {
  const currentDate = useStore((state) => state.currentDate)
  
  const mondayOfWeek = startOfWeek(currentDate, { weekStartsOn: 1 })
  const daysOfWeek = Array.from({ length: 5 }).map((_, i) => addDays(mondayOfWeek, i))
  
  return (
    <div className="fixed bottom-4 left-4 bg-white p-4 rounded shadow-lg z-50 text-xs">
      <h3 className="font-bold mb-2">Debug Info</h3>
      <p>Current Date: {format(currentDate, "PPP")}</p>
      <p>Day of Week: {format(currentDate, "EEEE")} ({currentDate.getDay()})</p>
      <p>Monday: {format(mondayOfWeek, "PPP")}</p>
      <hr className="my-2" />
      <p className="font-semibold">Week Days:</p>
      {daysOfWeek.map((day, i) => (
        <p key={i}>{format(day, "EEEE, MMM d")}</p>
      ))}
    </div>
  )
}
